# Copy to .secrets.env and fill in. Never commit .secrets.env (git-ignored).
# Terraform auth: the OCI provider reads these from the environment.
# Oracle docs: https://docs.oracle.com/en-us/iaas/Content/API/Concepts/sdkconfig.htm
TF_VAR_tenancy_ocid=ocid1.tenancy.oc1..REPLACE
# No quotes: make passes the value through literally and OKE rejects them.
TF_VAR_ssh_public_key=ssh-ed25519 AAAA... you@laptop

# Used by `make up` (cert-manager ClusterIssuer) and `make manifests`.
ACME_EMAIL=you@example.com

# Cloudflare API token, scoped to Zone:DNS:Edit and Zone:Zone:Read on lazzarotto.dev.
CLOUDFLARE_API_TOKEN=REPLACE

# OCIR pull credentials. Used by `make registry-secret` (run by `up` and `deploy ENV=oke`)
# to create the `ocir` docker-registry secret the app pods pull through. Same auth token
# as OCIR_AUTH_TOKEN in the repository secrets, and the username is
# tenancy-namespace/identity-domain/user.
OCIR_USERNAME=REPLACE
OCIR_AUTH_TOKEN=REPLACE

# Full image reference, no tag: the manifests pin :latest.
# The registry host must match the OCIR_REGION repository variable, and OCIR_AUTH_TOKEN
# must be valid for that registry.
OCIR_IMAGE=eu-milan-1.ocir.io/REPLACE_NAMESPACE/dinner-roulette:latest
